NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep false for the public preview. This flag is not sufficient to enable live
# interactions: the database launch control must also be approved and enabled.
NEXT_PUBLIC_TAG_TOKYO_LIVE_ENABLED=false

# Public operator information. Live interaction remains disabled until all
# three values are configured in the production build.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DATING_SERVICE_NOTIFICATION_NUMBER=

# Required before enabling paid items. These values are public on the
# commercial-transactions disclosure page.
NEXT_PUBLIC_COMMERCE_SELLER_NAME=
NEXT_PUBLIC_COMMERCE_RESPONSIBLE_PERSON=
NEXT_PUBLIC_COMMERCE_ADDRESS=
NEXT_PUBLIC_COMMERCE_PHONE=

# Server-only variables. Never expose these in NEXT_PUBLIC_ variables or Git.
# AGE_VERIFICATION_PROVIDER_*=
# MODERATION_ALERT_WEBHOOK_URL=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1RKFX1HCCV

# Google AdSense. Keep blank until the site is approved. Ads are rendered only
# on HOME and MAP; never on messages, registration, age verification, or admin.
# Optional override. Production defaults to this public publisher ID.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6265700167821181
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_MAP=
NEXT_PUBLIC_ADSENSE_PREVIEW=false
